#!/usr/bin/env bash
# bin/check --staged    pre-commit: judge only the index (build runs in a snapshot of it)
# bin/check [gate|all]  gates: build harness (harness always runs): silent on pass, prints only failing step output.
set -u
cd "$(dirname "$0")/.."
git config core.hooksPath >/dev/null 2>&1 || git config core.hooksPath .githooks
GATES="build harness"

gate_paths() { case $1 in build) echo "Sources Package.swift Package.resolved Resources";; esac; }
step_build_swift() { swift build; }

run_step() {
  local out
  if out=$("$2" 2>&1); then echo "✓ $1: $3"; else echo "✗ $1: $3" >&2; printf '%s\n' "$out" | awk 'length < 500' >&2; exit 1; fi
}
harness_bad() {
  git ls-files .claude | rg -v '^\.claude/skills$' || true
  if [ -e .claude/skills ] || [ -L .claude/skills ]; then
    [ -L .claude/skills ] && [ "$(readlink .claude/skills)" = ../.agents/skills ] || echo .claude/skills
  fi
}
gate_harness() {
  local bad
  bad=$(harness_bad)
  if [ -n "$bad" ]; then printf '%s\n' "$bad"; exit 1; fi
  echo "✓ harness: .claude holds only the skills link"
}
snap=
build_snapshot() {
  root=$PWD
  snap=$(mktemp -d)
  trap 'rm -rf "$snap"' EXIT
  git checkout-index -a --prefix="$snap/"
  [ -d "$root/.build" ] && ln -s "$root/.build" "$snap/.build"
  return 0
}
step_build_staged() { ( cd "$snap" && unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX && swift build ); }
run_gate() {
  case $1 in
    harness) gate_harness;;
    build) if [ "$sel" = --staged ]; then build_snapshot; run_step build step_build_staged "swift build"; else run_step build step_build_swift "swift build"; fi;;
  esac
}

sel=${1:-}
if [ "$sel" = all ]; then todo=$GATES
elif [ "$sel" = --staged ]; then
  changed=$(git diff --cached --name-only --diff-filter=ACMRD)
  todo=harness
  for p in $(gate_paths build); do
    if printf '%s\n' "$changed" | rg -q "^${p}(/|$)"; then todo="$todo build"; break; fi
  done
elif [ -n "$sel" ]; then
  case " $GATES " in *" $sel "*) todo=$sel;; *) echo "unknown gate: $sel (gates: $GATES)" >&2; exit 2;; esac
else
  base=$(git merge-base HEAD main 2>/dev/null || echo HEAD)
  changed=$( { git diff --name-only "$base"; git ls-files --others --exclude-standard; } 2>/dev/null | sort -u)
  todo=harness
  for g in $GATES; do
    [ "$g" = harness ] && continue
    for p in $(gate_paths "$g"); do
      if printf '%s\n' "$changed" | rg -q "^${p}(/|$)"; then todo="$todo $g"; break; fi
    done
  done
fi
for g in $todo; do run_gate "$g"; done
exit 0
